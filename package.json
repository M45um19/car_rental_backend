{
  "name": "car-rental-backend",
  "version": "1.0.0",
  "description": "Vehicle Rental Management Backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx node_modules/knex/bin/cli.js migrate:latest",
    "db:rollback": "tsx node_modules/knex/bin/cli.js migrate:rollback",
    "db:seed": "tsx node_modules/knex/bin/cli.js seed:run",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^2.13.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "redis": "^4.6.13",
    "swagger-ui-express": "^5.0.0",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/swagger-ui-express": "^4.1.6",
    "eslint": "^9.3.0",
    "prettier": "^3.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  }
}
