{
  "openapi": "3.0.0",
  "info": {
    "title": "Vehicle Rental Management System API",
    "version": "1.0.0",
    "description": "REST API documentation for the Vehicle Rental fleet management, bookings, and reports."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token in the format: Bearer <token>"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate staff member",
        "description": "Log in with email and password to receive a JWT access token.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "admin@rental.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "Password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Login successful"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                        },
                        "refreshToken": {
                          "type": "string",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                        },
                        "deviceId": {
                          "type": "string",
                          "example": "018b3f11-7360-7000-8000-000000000001"
                        },
                        "staff": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 1
                            },
                            "email": {
                              "type": "string",
                              "example": "admin@rental.com"
                            },
                            "name": {
                              "type": "string",
                              "example": "Admin Staff"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Invalid email or password"
          }
        }
      }
    },
    "/vehicles": {
      "post": {
        "summary": "Create a new vehicle",
        "description": "Create a new vehicle record in the system fleet, upload its photo, and index it in OpenSearch.",
        "tags": [
          "Vehicles"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "plate_number",
                  "category",
                  "daily_rate"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Tesla Model S"
                  },
                  "plate_number": {
                    "type": "string",
                    "example": "XYZ-789"
                  },
                  "category": {
                    "type": "string",
                    "example": "Sedan"
                  },
                  "daily_rate": {
                    "type": "number",
                    "format": "float",
                    "example": 120.00
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Vehicle image file (jpeg, jpg, png, webp)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vehicle created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Vehicle created successfully"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1
                        },
                        "name": {
                          "type": "string",
                          "example": "Tesla Model S"
                        },
                        "plate_number": {
                          "type": "string",
                          "example": "XYZ-789"
                        },
                        "category": {
                          "type": "string",
                          "example": "Sedan"
                        },
                        "daily_rate": {
                          "type": "number",
                          "example": 120.00
                        },
                        "photo_path": {
                          "type": "string",
                          "example": "uploads/1700000000000-photo.jpg"
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid file type"
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token"
          },
          "409": {
            "description": "Conflict - Plate number already exists"
          }
        }
      },
      "get": {
        "summary": "Fetch paginated vehicles list",
        "description": "Fetch list of active vehicles using cursor pagination. Can filter by category or search by name. Accelerated by Redis and OpenSearch.",
        "tags": [
          "Vehicles"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of vehicles to return",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Vehicle ID to start paginating from",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter by category name",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search by vehicle name (fuzzy search)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicles list fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Vehicles list fetched successfully"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "vehicles": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1
                              },
                              "name": {
                                "type": "string",
                                "example": "Tesla Model S"
                              },
                              "plate_number": {
                                "type": "string",
                                "example": "XYZ-789"
                              },
                              "category": {
                                "type": "string",
                                "example": "Sedan"
                              },
                              "daily_rate": {
                                "type": "number",
                                "example": 120.00
                              },
                              "photo_path": {
                                "type": "string",
                                "example": "/uploads/vehicles/sample.jpg"
                              },
                              "created_at": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "updated_at": {
                                "type": "string",
                                "format": "date-time"
                              }
                            }
                          }
                        },
                        "nextCursor": {
                          "type": "integer",
                          "nullable": true,
                          "example": 2
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vehicles/{id}": {
      "get": {
        "summary": "Fetch single vehicle details by ID",
        "description": "Get detailed vehicle information. Utilizes Redis details cache.",
        "tags": [
          "Vehicles"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Vehicle ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Vehicle fetched successfully"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1
                        },
                        "name": {
                          "type": "string",
                          "example": "Tesla Model S"
                        },
                        "plate_number": {
                          "type": "string",
                          "example": "XYZ-789"
                        },
                        "category": {
                          "type": "string",
                          "example": "Sedan"
                        },
                        "daily_rate": {
                          "type": "number",
                          "example": 120.00
                        },
                        "photo_path": {
                          "type": "string",
                          "example": "uploads/1700000000000-photo.jpg"
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid vehicle ID parameter"
          },
          "404": {
            "description": "Vehicle not found"
          }
        }
      },
      "put": {
        "summary": "Update an existing vehicle",
        "description": "Update vehicle fields and optionally upload a new photo. Updates PostgreSQL, Redis, and OpenSearch.",
        "tags": [
          "Vehicles"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Vehicle ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Tesla Model S Plaid"
                  },
                  "plate_number": {
                    "type": "string",
                    "example": "XYZ-789"
                  },
                  "category": {
                    "type": "string",
                    "example": "Sedan"
                  },
                  "daily_rate": {
                    "type": "number",
                    "format": "float",
                    "example": 150.00
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional updated vehicle image file"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vehicle updated successfully"
          },
          "400": {
            "description": "Validation error or invalid ID parameter"
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token"
          },
          "404": {
            "description": "Vehicle not found"
          },
          "409": {
            "description": "Conflict - Plate number already exists"
          }
        }
      },
      "delete": {
        "summary": "Soft delete a vehicle",
        "description": "Soft deletes vehicle from DB, purges Redis caches, and removes document from OpenSearch index.",
        "tags": [
          "Vehicles"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Vehicle ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle deleted successfully"
          },
          "400": {
            "description": "Invalid vehicle ID parameter"
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token"
          },
          "404": {
            "description": "Vehicle not found"
          }
        }
      }
    },
    "/rentals": {
      "post": {
        "summary": "Create a new rental booking",
        "description": "Submits a rental booking request. Checks Redis availability slots, acquires Redis lock, and queues message into Kafka batch pipeline.",
        "tags": [
          "Rentals"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "vehicle_id",
                  "customer_name",
                  "customer_phone",
                  "start_date",
                  "end_date",
                  "total_amount"
                ],
                "properties": {
                  "vehicle_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "customer_name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "customer_phone": {
                    "type": "string",
                    "example": "+1234567890"
                  },
                  "start_date": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-08-15"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-08-20"
                  },
                  "total_amount": {
                    "type": "number",
                    "example": 250.00
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Rental booking submitted and queued successfully"
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Vehicle not found"
          },
          "409": {
            "description": "Conflict - Vehicle slot is already booked or locked"
          }
        }
      }
    },
    "/rentals/{id}": {
      "get": {
        "summary": "Fetch single rental details by ID",
        "description": "Fetches single rental record by ID from PostgreSQL.",
        "tags": [
          "Rentals"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Rental ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rental details fetched successfully"
          },
          "400": {
            "description": "Invalid rental ID parameter"
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token"
          },
          "404": {
            "description": "Rental not found"
          }
        }
      }
    }
  }
}
